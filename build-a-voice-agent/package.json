{
  "name": "build-a-voice-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./src/instrumentation.mjs' tsx watch src/server.ts",
    "start": "node --import ./src/instrumentation.mjs --import tsx src/server.ts",
    "start:watch": "NODE_OPTIONS='--import ./src/instrumentation.mjs' tsx watch src/server.ts",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run inngest:dev\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:coverage": "node --test --import tsx --experimental-test-coverage test/*.test.ts",
    "test:demo": "node scripts/demo-test.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "tunnel": "node scripts/start-ngrok.mjs",
    "setup:auth": "node scripts/setup-vapi-auth.mjs",
    "deploy:vapi": "node scripts/deploy-vapi.mjs",
    "check:vapi-config": "node scripts/check-vapi-config.mjs",
    "validate:vapi": "node scripts/validate-vapi-assets.mjs",
    "setup:vapi-simulations": "node scripts/setup-vapi-simulations.mjs",
    "test:vapi": "node scripts/vapi-chat-test.mjs",
    "test:vapi-simulations": "node scripts/run-vapi-simulations.mjs",
    "inngest:dev": "tsx scripts/inngest-dev.ts"
  },
  "dependencies": {
    "@inngest/otel": "^0.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "inngest": "^4.13.0",
    "openai": "^6.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
